import { commandSucceeded, isFalse } from "niceeval/expect";
import { defineEval } from "niceeval";

const regressionTest = `"use strict";

const assert = require("assert");
const express = require("../");

describe("app.enabled regression", function () {
  it("returns false after an application setting is disabled", function () {
    const app = express();
    app.disable("feature-x");
    assert.strictEqual(app.enabled("feature-x"), false);
  });

  it("returns true after an application setting is enabled", function () {
    const app = express();
    app.enable("feature-x");
    assert.strictEqual(app.enabled("feature-x"), true);
  });
});
`;

export default defineEval({
  description: "Repair a regression in Express application setting checks",
  tags: ["coding", "express", "regression"],
  async test(t) {
    await t.sandbox.runShell("cp -a /opt/express/. .");
    await t.sandbox.writeText("test/eval-enabled-regression.js", regressionTest);
    await t.sandbox.runShell(
      "sed -i 's/return this.set(setting) === true;/return !!this.set(setting);/' lib/application.js",
    );

    const before = await t.sandbox.runCommand("./node_modules/.bin/mocha", [
      "test/eval-enabled-regression.js",
    ]);
    t.check(before.exitCode === 0, isFalse()).label("Seeded regression fails");

    const turn = await t.send(`A regression was introduced in Express application setting checks. The focused test suite at test/eval-enabled-regression.js currently fails: after app.disable("feature-x"), app.enabled("feature-x") incorrectly reports true. Fix the implementation in lib/application.js without weakening the test, and run the focused test to verify both disabled and enabled behavior.`);
    turn.succeeded().label("Codex completed the repair");

    const after = await t.sandbox.runCommand("./node_modules/.bin/mocha", [
      "test/eval-enabled-regression.js",
    ]);
    t.check(after, commandSucceeded()).label("Disabled and enabled behavior passes");
    t.sandbox.fileChanged("lib/application.js").label("Repair changed the implementation");
  },
});
