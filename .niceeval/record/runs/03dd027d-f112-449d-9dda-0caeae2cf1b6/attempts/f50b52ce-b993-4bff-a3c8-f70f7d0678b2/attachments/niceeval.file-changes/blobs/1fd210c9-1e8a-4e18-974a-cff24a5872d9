import { Template } from "e2b";
import {
  NICEEVAL_CODEX_E2B_TEMPLATE,
  verifyE2BNodeToolContract,
} from "niceeval/sandbox/e2b-template";

const template = verifyE2BNodeToolContract(
  Template()
    .fromTemplate(NICEEVAL_CODEX_E2B_TEMPLATE)
    .copy("package.json", "/opt/express/package.json")
    .copy("pnpm-lock.yaml", "/opt/express/pnpm-lock.yaml")
    .copy("pnpm-workspace.yaml", "/opt/express/pnpm-workspace.yaml")
    .copy("index.js", "/opt/express/index.js")
    .copy("lib", "/opt/express/lib")
    .copy("test", "/opt/express/test")
    .copy("History.md", "/opt/express/History.md")
    .copy("LICENSE", "/opt/express/LICENSE")
    .copy("Readme.md", "/opt/express/Readme.md")
    .runCmd("corepack enable && cd /opt/express && pnpm install --frozen-lockfile"),
);

await Template.build(template, "express-niceeval-codex:0.144.1-r5", {
  cpuCount: 2,
  memoryMB: 4096,
});
