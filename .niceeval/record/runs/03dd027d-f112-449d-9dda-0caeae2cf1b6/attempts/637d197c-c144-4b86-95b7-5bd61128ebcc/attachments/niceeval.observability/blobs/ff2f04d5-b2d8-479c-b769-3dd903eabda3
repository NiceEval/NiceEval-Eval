// ./agents/gpt-researcher.ts
import { defineAgent, type Agent, type EvidenceCoverage } from "niceeval/adapter";

type ReportResponse = {
  research_id?: string;
  report?: string;
  research_information?: {
    source_urls?: string[];
    research_costs?: number;
    visited_urls?: string[];
  };
};

const evidenceCoverage = {
  events: { status: "partial", reason: "The HTTP endpoint returns only the final report." },
  actions: { status: "unavailable", reason: "The HTTP response does not expose tool lifecycles." },
  messages: { status: "complete" },
  usage: { status: "partial", reason: "The response exposes aggregate research cost, not token usage." },
  status: { status: "complete" },
  data: { status: "complete" },
} satisfies EvidenceCoverage;

export function gptResearcher(options: { baseUrl: string }): Agent {
  return defineAgent({
    name: "gpt-researcher-http",
    evidenceCoverage,
    async send(input, ctx) {
      ctx.progress({ message: "Requesting a local-source research report" });

      const response = await fetch(`${options.baseUrl}/report/`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          task: input.text,
          report_type: "research_report",
          report_source: "local",
          tone: "Informative (providing clear and comprehensive information)",
          repo_name: "gpt-researcher",
          branch_name: "main",
          generate_in_background: false,
        }),
        signal: ctx.signal,
      });

      const body = (await response.json()) as ReportResponse;
      const report = typeof body.report === "string" ? body.report : "";

      return {
        status: response.ok ? "completed" : "failed",
        events: [{ type: "message", role: "assistant", text: report }],
        data: {
          researchId: body.research_id ?? null,
          sourceUrls: body.research_information?.source_urls ?? [],
          visitedUrls: body.research_information?.visited_urls ?? [],
          researchCost: body.research_information?.research_costs ?? null,
        },
      };
    },
  });
}

