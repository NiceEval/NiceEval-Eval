import { defineAgent, type EvidenceCoverage } from "niceeval/adapter";

type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

type RunResponse = {
  run_id: string;
  status: string;
  output?: Json;
  failure_reason?: string | null;
  errors?: Array<{ message?: string }>;
};

type TimelineItem = {
  block?: {
    workflow_run_block_id: string;
    block_type: string;
    label?: string | null;
    status?: string | null;
    output?: Json;
    failure_reason?: string | null;
  } | null;
  children?: TimelineItem[];
};

const evidenceCoverage: EvidenceCoverage = {
  events: { status: "partial", reason: "Skyvern exposes completed workflow blocks only after polling." },
  actions: { status: "partial", reason: "The public timeline omits browser-level action lifecycles." },
  messages: { status: "complete" },
  usage: { status: "unavailable", reason: "The workflow run API does not return model usage." },
  status: { status: "complete" },
  data: { status: "complete" },
};

const terminalStatuses = new Set(["completed", "failed", "terminated", "canceled", "timed_out"]);

export function skyvernWorkflow(options: {
  agentId: string;
  baseUrl: string;
  apiKey?: string;
  inputParameter: string;
}) {
  return defineAgent({
    name: `skyvern-workflow:${options.agentId || "unconfigured"}`,
    evidenceCoverage,
    async send(input, ctx) {
      if (!options.agentId) {
        throw new Error("Set the experiment's SKYVERN_NICEEVAL_*_AGENT_ID before running it.");
      }

      const headers: Record<string, string> = { "content-type": "application/json" };
      if (options.apiKey) headers["x-api-key"] = options.apiKey;

      ctx.progress({ message: "Submitting Skyvern workflow" });
      const submitted = await fetch(`${options.baseUrl}/v1/run/agents`, {
        method: "POST",
        headers,
        body: JSON.stringify({
          agent_id: options.agentId,
          parameters: { [options.inputParameter]: input.text },
        }),
        signal: ctx.signal,
      });
      const started = (await submitted.json()) as RunResponse;
      if (!submitted.ok) {
        return {
          status: "failed",
          events: [{ type: "error", message: started.failure_reason ?? "Skyvern rejected the workflow run." }],
        };
      }

      let run = started;
      while (!terminalStatuses.has(run.status)) {
        await new Promise((resolve) => setTimeout(resolve, 1_000));
        ctx.progress({ message: `Waiting for Skyvern run ${run.run_id}` });
        const response = await fetch(`${options.baseUrl}/v1/runs/${run.run_id}`, {
          headers,
          signal: ctx.signal,
        });
        if (!response.ok) throw new Error(`Skyvern run lookup failed with HTTP ${response.status}.`);
        run = (await response.json()) as RunResponse;
      }

      const events = await workflowEvents(options.baseUrl, run.run_id, headers, ctx.signal);
      if (run.output !== undefined) {
        if (typeof run.output === "string") {
          events.push({ type: "message", role: "assistant", text: run.output });
        } else {
          events.push({ type: "message", role: "assistant", text: JSON.stringify(run.output) });
        }
      }
      if (run.failure_reason) events.push({ type: "error", message: run.failure_reason });

      return {
        status: run.status === "completed" ? "completed" : "failed",
        events,
        ...(run.output !== undefined && typeof run.output !== "string" ? { data: run.output } : {}),
      };
    },
  });
}

async function workflowEvents(
  baseUrl: string,
  runId: string,
  headers: Record<string, string>,
  signal: AbortSignal,
) {
  const response = await fetch(`${baseUrl}/v1/runs/${runId}/timeline`, { headers, signal });
  if (!response.ok) return [];

  const timeline = (await response.json()) as TimelineItem[];
  return flattenBlocks(timeline).flatMap((block) => {
    const name = block.label || `workflow_block:${block.block_type}`;
    const input = { blockType: block.block_type, label: block.label ?? undefined };
    return [
      {
        type: "operation.started" as const,
        operationId: block.workflow_run_block_id,
        operation: { kind: "tool" as const, name, input },
      },
      {
        type: "operation.finished" as const,
        operationId: block.workflow_run_block_id,
        kind: "tool" as const,
        ...(block.output !== undefined ? { output: block.output } : {}),
        status: block.status === "completed" ? ("completed" as const) : ("failed" as const),
      },
    ];
  });
}

function flattenBlocks(items: TimelineItem[]): NonNullable<TimelineItem["block"]>[] {
  return items.flatMap((item) => [
    ...(item.block ? [item.block] : []),
    ...flattenBlocks(item.children ?? []),
  ]);
}
