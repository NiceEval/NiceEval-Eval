// ./agents/openhands.ts
import { defineAgent } from "niceeval/adapter";
import type { Agent, EvidenceCoverage, StreamEvent } from "niceeval/adapter";

interface OpenHandsEvent {
  id?: string;
  kind?: string;
  source?: string;
  llm_message?: { role?: string; content?: unknown };
  action?: { kind?: string; id?: string; [key: string]: unknown };
  observation?: { cause?: string; [key: string]: unknown };
}

interface OpenHandsConversation {
  id?: string;
  conversation_url?: string;
  session_api_key?: string;
  execution_status?: string;
}

interface OpenHandsOptions {
  baseUrl: string;
  apiKey?: string;
  pollIntervalMs?: number;
}

const evidenceCoverage = {
  events: {
    status: "partial",
    reason: "The OpenHands event API is polled after each turn rather than streamed.",
  },
  actions: {
    status: "partial",
    reason: "Only action and observation events exposed by the OpenHands API are mapped.",
  },
  messages: { status: "complete" },
  usage: {
    status: "unavailable",
    reason: "The conversation event API does not return normalized token usage.",
  },
  status: { status: "complete" },
  data: {
    status: "unavailable",
    reason: "OpenHands returns conversational events rather than a structured response body.",
  },
} satisfies EvidenceCoverage;

const terminalStatuses = new Set([
  "idle",
  "stopped",
  "completed",
  "failed",
  "error",
  "awaiting_user_input",
]);

const failedStatuses = new Set(["failed", "error"]);

function textFromContent(content: unknown): string {
  if (typeof content === "string") return content;
  if (!Array.isArray(content)) return "";

  return content
    .map((item) => {
      if (typeof item === "string") return item;
      if (item && typeof item === "object" && "text" in item) {
        const text = (item as { text?: unknown }).text;
        return typeof text === "string" ? text : "";
      }
      return "";
    })
    .filter(Boolean)
    .join("\n");
}

function mapEvents(events: OpenHandsEvent[]): StreamEvent[] {
  const mapped: StreamEvent[] = [];
  const actionIds = new Map<string, string>();

  for (const event of events) {
    if (
      event.kind === "MessageEvent" &&
      event.llm_message?.role === "assistant"
    ) {
      const text = textFromContent(event.llm_message.content);
      if (text) mapped.push({ type: "message", role: "assistant", text });
      continue;
    }

    if (event.kind === "ActionEvent" && event.action?.kind) {
      const operationId = event.action.id ?? event.id ?? crypto.randomUUID();
      actionIds.set(operationId, event.action.kind);
      mapped.push({
        type: "operation.started",
        operationId,
        operation: {
          kind: "tool",
          name: event.action.kind,
          input: event.action,
        },
      });
      continue;
    }

    if (event.kind === "ObservationEvent" && event.observation?.cause) {
      const operationId = event.observation.cause;
      if (actionIds.has(operationId)) {
        mapped.push({
          type: "operation.finished",
          operationId,
          kind: "tool",
          output: event.observation,
          status: "completed",
        });
      }
    }
  }

  return mapped;
}

function headers(apiKey?: string): HeadersInit {
  return {
    "content-type": "application/json",
    ...(apiKey ? { authorization: `Bearer ${apiKey}` } : {}),
  };
}

async function responseJson(response: Response): Promise<unknown> {
  if (!response.ok) throw new Error(`OpenHands returned HTTP ${response.status}`);
  return response.json();
}

export function openHandsAgent(options: OpenHandsOptions): Agent {
  const baseUrl = options.baseUrl.replace(/\/$/, "");
  const pollIntervalMs = options.pollIntervalMs ?? 1_000;

  return defineAgent({
    name: "openhands-app-conversation",
    evidenceCoverage,
    async send(input, ctx) {
      let conversation: OpenHandsConversation;

      if (ctx.session.id) {
        conversation = { id: ctx.session.id };
        const sendResponse = await fetch(
          `${baseUrl}/api/v1/app-conversations/${ctx.session.id}/send-message`,
          {
            method: "POST",
            headers: headers(options.apiKey),
            body: JSON.stringify({
              role: "user",
              content: [{ type: "text", text: input.text }],
              run: true,
            }),
            signal: ctx.signal,
          },
        );
        await responseJson(sendResponse);
      } else {
        ctx.progress({ message: "Creating OpenHands conversation" });
        const startResponse = await fetch(`${baseUrl}/api/v1/app-conversations`, {
          method: "POST",
          headers: headers(options.apiKey),
          body: JSON.stringify({
            initial_message: {
              role: "user",
              content: [{ type: "text", text: input.text }],
              run: true,
            },
          }),
          signal: ctx.signal,
        });
        const task = (await responseJson(startResponse)) as { id: string };

        for (;;) {
          const taskResponse = await fetch(
            `${baseUrl}/api/v1/app-conversations/start-tasks?ids=${encodeURIComponent(task.id)}`,
            { headers: headers(options.apiKey), signal: ctx.signal },
          );
          const tasks = (await responseJson(taskResponse)) as Array<{
            status?: string;
            app_conversation_id?: string;
            detail?: string;
          }>;
          const currentTask = tasks[0];
          if (currentTask?.status === "READY" && currentTask.app_conversation_id) {
            conversation = { id: currentTask.app_conversation_id };
            ctx.session.capture(conversation.id);
            break;
          }
          if (currentTask?.status === "ERROR") {
            throw new Error(`OpenHands failed to start: ${currentTask.detail ?? "unknown error"}`);
          }
          await new Promise((resolve) => setTimeout(resolve, pollIntervalMs));
        }
      }

      const conversationResponse = await fetch(
        `${baseUrl}/api/v1/app-conversations?ids=${encodeURIComponent(conversation.id!)}`,
        { headers: headers(options.apiKey), signal: ctx.signal },
      );
      const conversations = (await responseJson(conversationResponse)) as OpenHandsConversation[];
      const current = conversations[0];
      if (!current?.conversation_url || !current.session_api_key) {
        throw new Error("OpenHands did not expose an agent-server URL and session API key");
      }

      const eventUrl = `${current.conversation_url}/events/search`;
      let allEvents: OpenHandsEvent[] = [];
      let status = current.execution_status?.toLowerCase();
      do {
        ctx.progress({ message: "Waiting for OpenHands agent" });
        if (allEvents.length > 0 || !status || !terminalStatuses.has(status)) {
          await new Promise((resolve) => setTimeout(resolve, pollIntervalMs));
        }
        const [eventResponse, latestConversationResponse] = await Promise.all([
          fetch(eventUrl, {
            headers: { "X-Session-API-Key": current.session_api_key },
            signal: ctx.signal,
          }),
          fetch(
            `${baseUrl}/api/v1/app-conversations?ids=${encodeURIComponent(conversation.id!)}`,
            { headers: headers(options.apiKey), signal: ctx.signal },
          ),
        ]);
        const page = (await responseJson(eventResponse)) as { items?: OpenHandsEvent[] };
        allEvents = page.items ?? [];
        const latest = (await responseJson(latestConversationResponse)) as OpenHandsConversation[];
        status = latest[0]?.execution_status?.toLowerCase();
      } while (!status || !terminalStatuses.has(status));

      return {
        status: failedStatuses.has(status) ? "failed" : "completed",
        events: mapEvents(allEvents),
      };
    },
  });
}

