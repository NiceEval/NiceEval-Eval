FROM niceeval/codex:v0.11.0

# The host installs these once. Every local attempt receives only a fresh
# workspace and reuses this immutable dependency layer through NODE_PATH.
COPY --chown=node:node node_modules /opt/express/node_modules

ENV NODE_PATH=/opt/express/node_modules

RUN test -x "$(command -v codex)" \
  && test -f /opt/express/node_modules/mocha/bin/mocha.js \
  && test -d /opt/express/node_modules/supertest

# NiceEval's Docker provider normally repeats this fixed bootstrap command for
# every attempt. This image already contains those packages, so make that exact
# invocation a no-op while preserving normal apt-get behavior for agent work.
RUN printf '%s\n' \
  '#!/bin/sh' \
  'if [ "$1" = "update" ] && [ "$2" = "-qq" ] && [ "$#" = 2 ]; then exit 0; fi' \
  'if [ "$1" = "install" ] && [ "$2" = "-y" ] && [ "$3" = "-qq" ] && [ "$4" = "ca-certificates" ] && [ "$5" = "git" ] && [ "$6" = "curl" ] && [ "$#" = 6 ]; then exit 0; fi' \
  'exec /usr/bin/apt-get "$@"' \
  > /usr/local/bin/apt-get \
  && chmod 755 /usr/local/bin/apt-get
