import { dockerSandbox, e2bSandbox } from "niceeval/sandbox";

const localImage = "express-codex-evals:2026-08-19";
const e2bTemplate = "express-codex-evals:2026-08-19";

export function codexSandbox() {
  return process.env.CI
    ? e2bSandbox({ template: e2bTemplate })
    : dockerSandbox({ image: localImage });
}
