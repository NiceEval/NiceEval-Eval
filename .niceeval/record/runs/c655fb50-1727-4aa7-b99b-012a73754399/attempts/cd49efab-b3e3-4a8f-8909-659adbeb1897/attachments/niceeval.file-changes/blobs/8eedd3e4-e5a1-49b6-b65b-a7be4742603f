import { defineEval } from "niceeval";
import { commandSucceeded, includes } from "niceeval/expect";

export default defineEval({
  description: "Add HTTP 418 regression coverage for res.sendStatus",
  async test(t) {
    await t.sandbox.uploadDirectory("..", ".", {
      ignore: ["node_modules", ".niceeval"],
    });
    await t.sandbox.runShell("ln -s /opt/express/node_modules node_modules");

    await t
      .send(
        "Add a regression test for Express's res.sendStatus() handling of HTTP 418 in " +
          "test/res.sendStatus.js. Follow the existing test style. The assertion must validate " +
          "the conventional reason phrase returned in the response body. Run only that test file " +
          "after making the change.",
      )
      .then((turn) => turn.succeeded());

    t.sandbox.fileChanged("test/res.sendStatus.js");

    const result = await t.sandbox.runCommand("node", [
      "/opt/express/node_modules/mocha/bin/mocha.js",
      "--require",
      "test/support/env",
      "--reporter",
      "spec",
      "--bail",
      "--check-leaks",
      "test/res.sendStatus.js",
    ]);
    t.check(result, commandSucceeded());

    const test = await t.sandbox.readFile("test/res.sendStatus.js");
    t.check(test, includes(/418/));
    t.check(test, includes(/I'm a Teapot/));
  },
});
