// ./evals/example-domain.eval.ts
import { defineEval } from "niceeval";

export default defineEval({
  description: "Extract a public page heading and decline unavailable contact data",
  timeoutMs: 180_000,
  async test(t) {
    const heading = await t.send("Extract the primary heading from the page.");
    heading.succeeded();
    heading.messageIncludes("IANA-managed Reserved Domains");

    const unavailableEmail = await t.send(
      "Extract the official customer support email address from the page. If there is no email address, say it is unavailable instead of inventing one.",
    );
    unavailableEmail.succeeded();
    unavailableEmail.messageIncludes(/unavailable|not found|no email|does not contain/i);
  },
});
