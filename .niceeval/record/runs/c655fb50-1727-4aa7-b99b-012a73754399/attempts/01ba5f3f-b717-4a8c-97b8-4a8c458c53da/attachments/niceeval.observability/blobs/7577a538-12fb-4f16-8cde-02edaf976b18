// ./agents/skyvern-task.ts
import { defineAgent, type Agent } from "niceeval/adapter";

type RunResponse = {
  run_id: string;
  status: string;
  output?: unknown;
  failure_reason?: string | null;
};

type SkyvernTaskOptions = {
  baseUrl: string;
  apiKey?: string;
  runWith: "agent" | "code";
};

const TERMINAL_STATUSES = new Set(["completed", "failed", "terminated", "timed_out", "canceled"]);

const FIXTURE_URL = "https://www.iana.org/domains/reserved";

function sleep(ms: number, signal: AbortSignal): Promise<void> {
  return new Promise((resolve, reject) => {
    const timer = setTimeout(resolve, ms);
    signal.addEventListener("abort", () => {
      clearTimeout(timer);
      reject(signal.reason);
    }, { once: true });
  });
}

export function skyvernTask(options: SkyvernTaskOptions): Agent {
  const baseUrl = options.baseUrl.replace(/\/$/, "");

  return defineAgent({
    name: `skyvern-task-${options.runWith}`,
    async send(input, ctx) {
      const headers: Record<string, string> = { "content-type": "application/json" };
      if (options.apiKey) headers["x-api-key"] = options.apiKey;

      const submitted = await fetch(`${baseUrl}/v1/run/tasks`, {
        method: "POST",
        headers,
        body: JSON.stringify({
          url: FIXTURE_URL,
          prompt: input.text,
          run_with: options.runWith,
          data_extraction_schema: { heading: "string", email: "string" },
          max_steps: 8,
        }),
        signal: ctx.signal,
      });

      if (!submitted.ok) {
        throw new Error(`Skyvern task submission failed with HTTP ${submitted.status}`);
      }

      let run = await submitted.json() as RunResponse;
      ctx.fact("skyvern.run_id", run.run_id);
      while (!TERMINAL_STATUSES.has(run.status)) {
        await sleep(1_000, ctx.signal);
        const status = await fetch(`${baseUrl}/v1/runs/${run.run_id}`, {
          headers: options.apiKey ? { "x-api-key": options.apiKey } : undefined,
          signal: ctx.signal,
        });
        if (!status.ok) throw new Error(`Skyvern run lookup failed with HTTP ${status.status}`);
        run = await status.json() as RunResponse;
      }

      const result = {
        status: run.status,
        output: run.output ?? null,
        failureReason: run.failure_reason ?? null,
      };
      const completed = run.status === "completed";
      return {
        status: completed ? "completed" : "failed",
        data: result,
        events: [
          {
            type: "message",
            role: "assistant",
            text: JSON.stringify(result),
          },
          ...(completed ? [] : [{ type: "error" as const, message: run.failure_reason ?? run.status }]),
        ],
      };
    },
  });
}

