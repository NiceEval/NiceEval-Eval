import { defineAgent } from "niceeval/adapter";
import type { Agent } from "niceeval/adapter";

type DBGPTChatOptions = {
  baseUrl: string;
  chatMode: string;
  database: string;
};

type CompletionChunk = {
  vis?: unknown;
  choices?: Array<{
    delta?: { content?: unknown };
    message?: { content?: unknown };
  }>;
};

function textFromChunk(value: string): string | undefined {
  if (value === "[DONE]") return undefined;

  try {
    const chunk = JSON.parse(value) as CompletionChunk;
    const content = chunk.vis ?? chunk.choices?.[0]?.message?.content ?? chunk.choices?.[0]?.delta?.content;
    return typeof content === "string" ? content : undefined;
  } catch {
    return value;
  }
}

async function readSseBody(response: Response): Promise<string> {
  if (!response.body) throw new Error("DB-GPT returned an empty response body");

  const reader = response.body.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  let reply = "";

  while (true) {
    const { done, value } = await reader.read();
    buffer += decoder.decode(value, { stream: !done });

    const frames = buffer.split(/\r?\n\r?\n/);
    buffer = frames.pop() ?? "";
    for (const frame of frames) {
      for (const line of frame.split(/\r?\n/)) {
        if (!line.startsWith("data:")) continue;
        const text = textFromChunk(line.slice(5).trimStart());
        if (text !== undefined) reply = text;
      }
    }

    if (done) break;
  }

  const trailing = textFromChunk(buffer.replace(/^data:\s?/, "").trim());
  if (trailing !== undefined) reply = trailing;
  if (!reply) throw new Error("DB-GPT SSE response did not contain assistant text");
  return reply;
}

export function dbgptChat(options: DBGPTChatOptions): Agent {
  return defineAgent({
    name: "dbgpt-chat",
    async send(input, ctx) {
      ctx.progress({ message: "Waiting for DB-GPT chat completion" });
      const response = await fetch(`${options.baseUrl}/api/v1/chat/completions`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "user-id": "niceeval",
        },
        body: JSON.stringify({
          chat_mode: options.chatMode,
          select_param: options.database,
          model_name: ctx.model,
          user_input: input.text,
          conv_uid: crypto.randomUUID(),
          incremental: false,
        }),
        signal: ctx.signal,
      });

      if (!response.ok) {
        throw new Error(`DB-GPT chat request failed with HTTP ${response.status}`);
      }

      return {
        status: "completed",
        events: [{ type: "message", role: "assistant", text: await readSseBody(response) }],
      };
    },
  });
}
