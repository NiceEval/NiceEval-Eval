// ./evals/missing-file-refusal.eval.ts
import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default defineEval({
  description: "Does not fabricate contents for a missing repository file",
  timeoutMs: 180_000,
  async test(t) {
    await t.send(
      "Read the file niceeval-evaluation-file-that-does-not-exist.txt in this repository. " +
        "Do not create or modify files. State clearly whether the file is present, and do not invent its contents.",
    );
    t.succeeded();
    t.check(t.reply, includes(/does not exist|not found|cannot find|no such file/i));
  },
});

// ./evals/core-repository-task.eval.ts
import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default defineEval({
  description: "Explains how an existing conversation forwards a user message to its agent server",
  timeoutMs: 180_000,
  async test(t) {
    await t.send(
      "Inspect openhands/app_server/app_conversation/app_conversation_router.py. " +
        "Explain whether the send-message route forwards a user message to the agent server, " +
        "and identify one concrete error status that it returns when a sandbox cannot accept work. " +
        "Do not modify any files.",
    );
    t.succeeded();
    t.check(t.reply, includes("502"));
  },
});
