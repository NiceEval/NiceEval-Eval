import { defineAgent } from "niceeval/adapter";
import type { Agent } from "niceeval/adapter";

type OpenHandsAgentOptions = {
  apiBaseUrl: string;
  headers: Record<string, string>;
};

type StartTask = {
  app_conversation_id?: string;
  id: string;
  status: string;
};

type Conversation = {
  conversation_url?: string;
  execution_status?: string;
  session_api_key?: string;
};

const POLL_INTERVAL_MS = 1_000;

function textFromEvent(value: unknown): string | undefined {
  if (!value || typeof value !== "object") return undefined;
  const event = value as Record<string, unknown>;
  const role = event.role ?? event.source;
  if (role !== "assistant" && role !== "agent") return undefined;

  if (typeof event.text === "string") return event.text;
  if (typeof event.content === "string") return event.content;

  if (Array.isArray(event.content)) {
    return event.content
      .filter(
        (part): part is Record<string, unknown> =>
          !!part && typeof part === "object" && part.type === "text",
      )
      .map((part) => part.text)
      .filter((text): text is string => typeof text === "string")
      .join("\n");
  }

  return undefined;
}

async function getJson<T>(url: string, init: RequestInit): Promise<T> {
  const response = await fetch(url, init);
  if (!response.ok) {
    throw new Error(`OpenHands request failed: ${response.status} ${response.statusText}`);
  }
  return (await response.json()) as T;
}

export function openHandsAgent(options: OpenHandsAgentOptions): Agent {
  const apiBaseUrl = options.apiBaseUrl.replace(/\/$/, "");

  return defineAgent({
    name: "openhands-agent-server",
    async send(input, ctx) {
      ctx.progress({ message: "Starting an OpenHands conversation" });
      const task = await getJson<StartTask>(`${apiBaseUrl}/app-conversations`, {
        method: "POST",
        headers: { "content-type": "application/json", ...options.headers },
        body: JSON.stringify(ctx.model ? { llm_model: ctx.model } : {}),
        signal: ctx.signal,
      });

      let conversationId = task.app_conversation_id;
      while (!conversationId) {
        if (ctx.signal.aborted) throw new Error("OpenHands conversation startup aborted");
        await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
        const tasks = await getJson<StartTask[]>(
          `${apiBaseUrl}/app-conversations/start-tasks?id=${encodeURIComponent(task.id)}`,
          { headers: options.headers, signal: ctx.signal },
        );
        const current = tasks[0];
        if (!current) throw new Error("OpenHands conversation startup task disappeared");
        if (current.status === "ERROR") {
          throw new Error("OpenHands failed to start a conversation");
        }
        conversationId = current.app_conversation_id;
      }

      const conversation = await getJson<Conversation>(
        `${apiBaseUrl}/app-conversations/${conversationId}`,
        { headers: options.headers, signal: ctx.signal },
      );
      if (!conversation.conversation_url || !conversation.session_api_key) {
        throw new Error("OpenHands did not provide an agent-server connection");
      }

      ctx.progress({ message: "Sending coding task to OpenHands" });
      await getJson(`${apiBaseUrl}/app-conversations/${conversationId}/send-message`, {
        method: "POST",
        headers: { "content-type": "application/json", ...options.headers },
        body: JSON.stringify({
          role: "user",
          content: [{ type: "text", text: input.text }],
          run: true,
        }),
        signal: ctx.signal,
      });

      const agentHeaders = { "X-Session-API-Key": conversation.session_api_key };
      const eventsUrl = `${conversation.conversation_url}/events/search`;
      let latestReply: string | undefined;

      while (!ctx.signal.aborted) {
        const [state, page] = await Promise.all([
          getJson<Conversation>(conversation.conversation_url, {
            headers: agentHeaders,
            signal: ctx.signal,
          }),
          getJson<{ items?: unknown[] }>(eventsUrl, {
            headers: agentHeaders,
            signal: ctx.signal,
          }),
        ]);
        for (const event of page.items ?? []) {
          const text = textFromEvent(event);
          if (text) latestReply = text;
        }
        if (latestReply && state.execution_status !== "RUNNING") {
          return {
            status: "completed",
            events: [{ type: "message", role: "assistant", text: latestReply }],
          };
        }
        await new Promise((resolve) => setTimeout(resolve, POLL_INTERVAL_MS));
      }

      throw new Error("OpenHands evaluation was aborted");
    },
  });
}
