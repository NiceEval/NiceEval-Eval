import { defineExperiment } from "niceeval";
import { openHandsAgent } from "../agents/openhands-agent-server.ts";

const apiBaseUrl = process.env.OPENHANDS_EVAL_BASE_URL ?? "http://127.0.0.1:3000/api/v1";
const apiKey = process.env.OPENHANDS_EVAL_API_KEY;

export default defineExperiment({
  description: "OpenHands baseline for a repository investigation task",
  agent: openHandsAgent({
    apiBaseUrl,
    headers: apiKey ? { Authorization: `Bearer ${apiKey}` } : {},
  }),
  evals: ["core-repository-task"],
  runs: 1,
  timeoutMs: 180_000,
});
