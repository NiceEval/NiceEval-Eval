t_live_conversation_info(\n        self,\n        sandbox: SandboxInfo,\n        conversation_ids: list[UUID],\n    ) -> list[ConversationInfo]:\n        \"\"\"Get agent status for multiple conversations from the Agent Server.\n\n        Uses the unified ``/api/conversations`` endpoint, which accepts both\n        regular and ACP agents through the ``AgentBase`` discriminated union.\n        \"\"\"\n        if not conversation_ids:\n            return []\n\n        agent_server_url = self._get_agent_server_url(sandbox)\n        headers: dict[str, str] = {}\n        if sandbox.session_api_key:\n            headers['X-Session-API-Key'] = sandbox.session_api_key\n\n        try:\n            url = f'{agent_server_url.rstrip(\"/\")}/api/conversations'\n            response = await self.httpx_client.get(\n                url,\n                params={'ids': [str(c) for c in conversation_ids]},\n                headers=headers,\n            )\n            response.raise_for_status()\n            data = response.json()\n            infos = _conversation_info_type_adapter.validate_python(data)\n            return [c for c in infos if c]\n        except httpx.HTTPStatusError:\n            _logger.warning(\n                f'Error getting conversation status from sandbox {sandbox.id}',\n                exc_info=True,\n            )\n        except Exception:\n            _logger.exception(\n                f'Error getting conversation status from sandbox","exit_code":0}},"command":{"kind":"command","original":{"state":"opaque","reason":"unsupported-protocol"},"logical":{"state":"opaque","normalizer":"logical-command/v1","reason":"original-opaque","originalReason":"unsupported-protocol"}},"start":{"turnOrdinal":1,"eventOrdinal":32},"lifecycle":{"state":"available","status":"completed","finish":{"turnOrdinal":1,"eventOrdinal":33}}},{"id":"[\"niceeval.logical-tool-occurrence/1\",\"session-1\",\"turn-1\",1,34]","session":"session-1","turn":"turn-1","name":{"original":"command_exec