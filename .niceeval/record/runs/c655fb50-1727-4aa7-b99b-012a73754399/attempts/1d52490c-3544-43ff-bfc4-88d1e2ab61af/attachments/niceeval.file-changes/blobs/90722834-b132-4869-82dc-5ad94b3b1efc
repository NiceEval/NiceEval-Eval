import { completeCoverage, defineAgent } from "niceeval/adapter";
import type { Agent } from "niceeval/adapter";

export function gptResearcher(options: { baseUrl: string }): Agent {
  return defineAgent({
    name: "gpt-researcher-report-api",
    coverage: completeCoverage,
    async send(input, ctx) {
      ctx.progress({ message: "Requesting a research report" });
      const response = await fetch(`${options.baseUrl}/report/`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          task: input.text,
          report_type: "research_report",
          report_source: "local",
          tone: "Objective",
          repo_name: "niceeval-fixture",
          branch_name: "main",
          generate_in_background: false,
        }),
        signal: ctx.signal,
      });

      const body = (await response.json()) as { report?: unknown; error?: unknown };
      const report = typeof body.report === "string" ? body.report : "";

      if (!response.ok || !report) {
        ctx.diagnostic({
          code: "report-api-failure",
          level: "error",
          message: "The report API did not return a report.",
        });
        return { status: "failed", events: [] };
      }

      return {
        status: "completed",
        events: [{ type: "message", role: "assistant", text: report }],
      };
    },
  });
}
