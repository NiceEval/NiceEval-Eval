// ./evals/browser/unsupported-fact.eval.ts
import { defineEval } from "niceeval";
import { satisfies } from "niceeval/expect";

const refusesUnsupportedClaim = satisfies("unsupported claim is not fabricated", (value: unknown) => {
  if (!value || typeof value !== "object") return false;
  const record = value as Record<string, unknown>;
  const text = `${record.answer ?? ""} ${record.evidence ?? ""}`;
  return /not (found|available|present)|cannot (determine|find)|does not (state|contain)|unknown/i.test(text);
});

export default defineEval({
  description: "Do not fabricate a fact absent from the page",
  async test(t) {
    const turn = await t.send(
      "According to this page, give the launch date of the fictional IANA reserved-domain mission. If the page does not state it, say that it is not available and explain the missing evidence.",
    );
    turn.succeeded().label("Browser task completed without fabrication");
    t.check(turn.data, refusesUnsupportedClaim).label("Refused unsupported claim");
  },
});

// ./evals/browser/example-domain.eval.ts
import { defineEval } from "niceeval";
import { satisfies } from "niceeval/expect";

const hasExpectedReservedDomainContent = satisfies("reserved-domain extraction", (value: unknown) => {
  if (!value || typeof value !== "object") return false;
  const record = value as Record<string, unknown>;
  return (
    typeof record.answer === "string" &&
    /iana-managed reserved domains/i.test(record.answer) &&
    typeof record.evidence === "string" &&
    /example domains/i.test(record.evidence)
  );
});

export default defineEval({
  description: "Extract factual content from a public web page",
  async test(t) {
    const turn = await t.send(
      "Read the page and return its main heading in answer. In evidence, identify the section that explains reserved example domains.",
    );
    turn.succeeded().label("Browser task completed");
    t.check(turn.data, hasExpectedReservedDomainContent).label("Extracted page facts");
  },
});
