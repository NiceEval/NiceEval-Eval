zh/reference/expect.mdx\nsed -n '1,280p' node_modules/niceeval/docs-site/zh/reference/define-eval.mdx\nsed -n '1,240p' node_modules/niceeval/dist/expect.d.ts 2>/dev/null || true\nfind node_modules/niceeval/dist -maxdepth 2 -type f -name '*expect*.d.ts' -o -name 'index.d.ts' | sort\""}},"output":{"state":"complete","value":{"output":"---\ntitle: \"niceeval/expect Match 参考\"\nsidebarTitle: \"断言 Matchers\"\ndescription: \"niceeval/expect 的纯 Match factory：组合文字、结构、条件，再交给 t.check 登记 Assertion。\"\n---\n\n`niceeval/expect` 只提供纯 Match factory。Match 比较一个候选值，不记录结果，也不决定判定或分数。`t.check(value, match)` 在调用时读取 `value` 并直接登记 Assertion；返回的 handle 只配置同一条 entry。\n\n```ts\nimport { and, excludes, includes, pattern } from \"niceeval/expect\";\n```\n\n## 使用方式\n\n```ts\nt.check(t.reply, includes(\"confirmed\"));\nt.check(t.reply, and(pattern(/order #\\d+/i), excludes(\"cancelled\")));\nconst config = await t.check(rawConfig, pattern(/runtime/)).orStop();\n```\n\n| 入口 | 作用 |\n|---|---|\n| `t.check(value, match)` | 严格两个参数，调用时登记 Assertion；失败不中止后续代码 |\n| `await handle.orStop()` | 同一 handle 的 async barrier；mismatch 或 below 时停止当前 continuation |\n| `handle.score(n)` / `t.score(n)` | 在计分制评估中让该项贡献分数，或直接登记 contribution |\n\n## Matchers\n\n下面每个 matcher 的签名和说明从 `niceeval/expect` 的源码生成，和当前实现保持同步。\n\n{/* GENERATED:BEGIN expect-matchers */}\n\n{/* 本区块由 pnpm docs:reference 从源码注释生成,勿手改;要改文案,改对应源码的 TSDoc/JSDoc(映射见 scripts/generate-reference.ts) */}\n\n#### `and`\n\n```ts\nexport function and(\n  first: BooleanMatch<unknown, unknown, MatchDomain>,\n  ...rest: readonly BooleanMatch<unknown, unknown, MatchDomain>[]\n): BooleanMatch<unknown, unknown, MatchDomain> { ... }\n```\n\n#### `or`\n\n```ts\nexport function or(\n  first: BooleanMatch<unknown, unknown, MatchDomain>,\n  ...rest: readonly BooleanMatch<unknown, unknown, MatchDomain>[]\n): BooleanMatch<unknown, unknown, MatchDomain> { ... }\n```\n\n#### `not`\n\n```ts\nexport function not<T>(match: BooleanMatch<T, T, \"value\">): BooleanMatch<T, T, \"value\"> { ... }\n```\n\n#### `includes`\n\n```ts\nexport function includes(text: string, options?: TextMatchOptions): BooleanMatch<string, string> { ... }\n```\n\n#### `excludes`\n\n```ts\nexport function excludes(text: string, options?: TextMatchOptions): BooleanMatch<string, string> { ... }\n```\n\n#### `pattern`\n\n```ts\nexport function pattern(expression: RegExp, options?: TextMatchOptions): BooleanMatch<string, string> { ... }\n```\n\n#### `similarity`\n\n```ts\nexport function similarity(expected: string): ScoreMatch<string> { ... }\n```\n\n归一化 Levenshtein similarity；它是连续分数，不携带默认阈值或 verdict 策略。\n\n#### `includesUrl`\n\n```ts\nexport function includesUrl(min = 1): BooleanMatch<string, string> { ... }\n```\n\n至少含 min 个去重 http(s) URL 的纯文本 matcher。\n\n#### `hasSections`\n\n```ts\nexport function hasSections(min = 2): BooleanMatch<string, string> { ... }\n```\n\n至少含 min 个 Markdown heading 的纯文本 matcher。\n\n#### `isDefined`\n\n```ts\nexport function isDefined<T = unknown>(label?: string): BooleanMatch<T, Exclude<T, null | undefined>> { ... }\n```\n\n#### `isTrue`\n\n```ts\nexport function isTrue<T = unknown>(label?: string): BooleanMatch<T, T & true> { ... }\n```\n\nvalue === true 的 refinement matcher。\n\n#### `isFalse`\n\n```ts\nexport function isFalse<T = unknown>(label?: string): BooleanMatch<T, T & false> { ... }\n```\n\nvalue === false 的 refinement matcher。\n\n#### `commandSucceeded`\n\n```ts\nexport function commandSucceeded<T = unknown>(): BooleanMatch<T, T & { readonly exitCode: 0 }> { ... }\n```\n\nCommandResult-like candidate 的 exitCode === 0 matcher；不读取 stdout / stderr。\n\n#### `equals`\n\n```ts\nexport function equals<const T>(expected: T): BooleanMatch<unknown, T> { ... }\n```\n\n#### `matches`\n\n```ts\nexport function matches<S extends StandardSchema>(\n  schema: S,\n): BooleanMatch<unknown, StandardSchema.InferInput<S>, \"value\"> { ... }\n```\n\n#### `satisfies`\n\n```ts\nexport function satisfies<T, R extends T = T>(\n  label: string,\n  predicate: (value: T) => boolean | Promise<boolean>,\n): BooleanMatch<T, R> | BooleanMatch<T, T> { ... }\n```\n\n#### `defineValueMatch`\n\n```ts\nexport function defineValueMatch<T, R extends T = T>(spec: {\n  readonly name: string;\n  readonly evaluate: (value: T) => boolean | Promise<boolean>;\n}): BooleanMatch<T, R> | BooleanMatch<T, T> { ... }\n```\n\n#### `defineScoreMatch`\n\n```ts\nexport function defineScoreMatch<T>(spec: {\n  readonly name: string;\n  readonly score: (value: T) => number | Promise<number>;\n}): ScoreMatch<T> { ... }\n```\n\n#### `eventMatch`\n\n```ts\nexport function eventMatch<K extends keyof EventOptionsByType>(\n  type: K,\n  options?: EventOptionsByType[K],\n): EventMatch<Extract<AssertionEvent, { readonly type: K }>> { ... }\n```\n\n{/* GENERATED:END expect-matchers */}\n\n### 匹配工具调用\n\n`ToolMatch` 比较一条 `LogicalToolOccurrence`。`calledTool` 接收 `ToolMatch`，或只按名称选择的薄糖；第二参数只表达次数。`notCalledTool` 使用相同 selector 表达零匹配。\n\n```ts\nimport {\n  commandMatch,\n  jsonMatch,\n  referencesAnyPath,\n  toolMatch,\n} from \"niceeval/expect\";\n\nturn.calledTool(\n  toolMatch(\"get_weather\", {\n    input: jsonMatch({ city: \"Taipei\", unit: \"celsius\" }),\n    status: \"completed\",\n  }),\n  { count: 1 },\n).label(\"精确查询天气\");\n\nturn.calledTool(\n  toolMatch(\"read_file\", {\n    input: referencesAnyPath([\".env\", \"secrets/**\"]),\n  }),\n).label(\"读取受限路径\");\n\nturn.notCalledTool(commandMatch(\"rm\", { argsStart: [\"-rf\"] }));\n```\n\n普通 JSON 用 `jsonMatch`，路径用 `referencesAnyPath`，命令 token 用 `commandMatch`。输出不存在、材料不完整或 HITL 尚未完成时，Match 会成为 unavailable，不会伪装成普通不匹配。\n\n完整签名、材料状态与三值计数规则见 [Scoped assertions](https://github.com/NiceEval/NiceEval/blob/main/docs/feature/assertions/library/scoped-assertions.md)。\n\n### 常见用法示例\n\n```ts\nt.check(t.reply, includes(\"Paris\"));\nt.check(t.reply, pattern(/order #\\d+/i));\nt.check(turn.data, equals({ intent: \"refund\" }));\nt.check(turn.data, matches(OrderSchema));\nt.check(turn.data, satisfies(\"返回数组\", Array.isArray));\nt.check(t.reply, similarity(\"The answer explains the refund window\")).atLeast(0.8);\n```\n\n## 组合与三态\n\n```ts\nt.check(t.reply, and(includes(\"required\"), excludes(\"forbidden\")));\nt.check(t.reply, or(includes(\"approved\"), includes(\"accepted\")));\n```\n\n同一 `and` / `or` 里的 Match 必须属于同一 domain。布尔 Match 的内部结果是 `matched`、`mismatched` 或 `unavailable`：`or` 只有在没有子项命中且至少一项证据不完整时才返回 `unavailable`，不会把未知当成否定。Match 自身不持有判定、计分或控制流；`.atLeast(n)`、`.score(n)` 与 `.orStop()` 属于登记后的 AssertionHandle。\n\n下面列出 Match 值本身的稳定字段。品牌和 evaluator 是模块私有实现，不属于作者 API。\n\n{/* GENERATED:BEGIN value-assertion */}\n\n{/* 本区块由 pnpm docs:reference 从源码注释生成,勿手改;要改文案,改对应源码的 TSDoc/JSDoc(映射见 scripts/generate-reference.ts) */}\n\n### `Match`\n\n#### `domain`\n\n```ts\nreadonly domain: D;\n```\n\n#### `name`\n\n```ts\nreadonly name: string;\n```\n\n### `BooleanMatch`\n\n#### `kind`\n\n```ts\nreadonly kind: \"boolean\";\n```\n\n#### `[matchRefinementBrand]`\n\n```ts\nreadonly [matchRefinementBrand]: () => R;\n```\n\n### `ScoreMatch`\n\n#### `kind`\n\n```ts\nreadonly kind: \"score\";\n```\n\n#### `atLeast`\n\n```ts\natLeast(threshold: number): ThresholdedScoreMatch<T>;\n```\n\n{/* GENERATED:END value-assertion */}\n\n## 自定义 matcher\n\n```ts\nimport { defineValueMatch } from \"niceeval/expect\";\n\nconst validEmail = () =>\n  defineValueMatch<string>({\n    name: \"valid email\",\n    evaluate(value) {\n      return value.includes(\"@\");\n    },\n  });\n\nt.check(t.reply, validEmail());\n```\n\n布尔自定义 Match 用 `defineValueMatch`，连续分数用 `defineScoreMatch`。两者只实现单候选比较；读取文件、扫描事件、决定 coverage 或修改判定仍由 Assertion 登记入口与 Runner 负责。\n---\ntitle: \"defineEval：声明、配置并运行 NiceEval 评估用例\"\nsidebarTitle: \"defineEval\"\ndescription: \"defineEval 参考：选项、test context t、T","exit_code":0}},"command":{"kind":"command","original":{"state":"opaque","reason":"unsupported-protocol"},"logical":{"state":"opaque","normalizer":"logical-command/v1","reason":"original-opaque","originalReason":"unsupported-protocol"}},"start":{"turnOrdinal":2,"eventOrdinal":26},"lifecycle":{"state":"available","status":"completed","finish":{"turnOrdinal":2,"eventOrdinal":27}}},{"id":"[\"niceeval.logical-tool-occurrence/1\",\"session-1\",\"turn-2\",2,28]","session":"session-1","turn":"turn-2","name":{"original":"command_execution","canonical":"shell"},"input":{"state":"complete","value":{"command":"/bin/bash -lc \"sed -n '1,240p' skyvern/webeye/actions/actions.py\nfind skyvern/webeye/actions -type f -name '*.py' -print0 | xargs -0 grep -nE 'action_type.*:|status.*:|class Action' | head -160\nsed -n '8080,8200p' skyvern/forge/sdk/workflow/service.py\nsed -n '5480,5540p' skyvern/forge/sdk/routes/agent_protocol.py\""}},"output":{"state":"complete","value":{"output":"from datetime import datetime\nfrom enum import StrEnum\nfrom typing import Annotated, Any, Literal, Type, TypeVar\n\nimport structlog\nfrom pydantic import BaseModel, ConfigDict, Field\n\nfrom skyvern.errors.errors import UserDefinedError\nfrom skyvern.utils.action_redaction import redact_input_text_payload_for_log\nfrom skyvern.webeye.actions.action_types import ActionType\n\nLOG = structlog.get_logger()\nT = TypeVar(\"T\", bound=\"Action\")\n\n\nclass CaptchaType(StrEnum):\n    TEXT_CAPTCHA = \"text_captcha\"\n    RECAPTCHA = \"recaptcha\"\n    HCAPTCHA = \"hcaptcha\"\n    MTCAPTCHA = \"mtcaptcha\"\n    FUNCAPTCHA = \"funcaptcha\"\n    CLOUDFLARE = \"cloudflare\"\n    OTHER = \"other\"\n\n\nclass ActionStatus(StrEnum):\n    pending = \"pending\"\n    skipped = \"skipped\"\n    failed = \"failed\"\n    completed = \"completed\"\n\n\nclass SelectOption(BaseModel):\n    label: str | None = None\n    value: str | None = None\n    index: int | None = None\n\n    def __repr__(self) -> str:\n        return f\"SelectOption(label={self.label}, value={self.value}, index={self.index})\"\n\n\nclass VerificationStatus(StrEnum):\n    \"\"\"Status of user goal verification.\"\"\"\n\n    complete = \"complete\"  # Goal achieved successfully\n    terminate = \"terminate\"  # Goal cannot be achieved, stop trying\n    continue_step = \"continue\"  # Goal not yet achieved, continue with more steps\n\n\nclass CompleteVerifyResult(BaseModel):\n    # New field: explicit status with three options (used when experiment is enabled)\n    status: VerificationStatus | None = None\n\n    # Legacy fields: for backward compatibility (used when experiment is disabled)\n    user_goal_achieved: bool = False\n    should_terminate: bool = False\n\n    thoughts: str\n    page_info: str | None = None\n    failure_categories: list[dict] = []\n\n    def __repr__(self) -> str:\n        if self.status:\n            return f\"CompleteVerifyResult(status={self.status}, thoughts={self.thoughts}, page_info={self.page_info})\"\n        return f\"CompleteVerifyResult(thoughts={self.thoughts}, user_goal_achieved={self.user_goal_achieved}, should_terminate={self.should_terminate}, page_info={self.page_info})\"\n\n    @property\n    def is_complete(self) -> bool:\n        \"\"\"True if goal was achieved (supports both new and legacy formats).\"\"\"\n        if self.status:\n            return self.status == VerificationStatus.complete\n        return self.user_goal_achieved\n\n    @property\n    def is_terminate(self) -> bool:\n        \"\"\"True if task should terminate (supports both new and legacy formats).\"\"\"\n        if self.status:\n            return self.status == VerificationStatus.terminate\n        return self.should_terminate\n\n    @property\n    def is_continue(self) -> bool:\n        \"\"\"True if task should continue (supports both new and legacy formats).\"\"\"\n        if self.status:\n            return self.status == VerificationStatus.continue_step\n        return not self.user_goal_achieved and not self.should_terminate\n\n\nclass InputOrSelectContext(BaseModel):\n    intention: str | None = None\n    field: str | None = None\n    is_required: bool | None = None\n    is_search_bar: bool | None = None  # don't trigger custom-selection logic when it's 