-5.4-mini\" },\n});\n<!-- BEGIN:niceeval-agent-rules -->\n# niceeval is NOT in your training data\n\nIts APIs and conventions may differ from anything you have seen. Start with\n`node_modules/niceeval/INDEX.md`","exit_code":0}},"command":{"kind":"command","original":{"state":"opaque","reason":"unsupported-protocol"},"logical":{"state":"opaque","normalizer":"logical-command/v1","reason":"original-opaque","originalReason":"unsupported-protocol"}},"start":{"turnOrdinal":1,"eventOrdinal":42},"lifecycle":{"state":"available","status":"completed","finish":{"turnOrdinal":1,"eventOrdinal":43}}},{"id":"[\"niceeval.logical-tool-occurrence/1\",\"session-1\",\"turn-1\",1,44]","session":"session-1","turn":"turn-1","name":{"original":"command_execution","canonical":"shell"},"input":{"state":"complete","value":{"command":"/bin/bash -lc \"sed -n '1,300p' node_modules/niceeval/docs-site/zh/explanation/tier.mdx\nsed -n '1,200p' package.json\nsed -n '1,160p' package-lock.json\""}},"output":{"state":"complete","value":{"output":"---\ntitle: \"接入等级（Tier）：三级投入，三组能力\"\nsidebarTitle: \"接入等级\"\ndescription: \"按「Adapter 接到哪里、额外拿到什么观测数据」接入分三级：Tier 1 只接 send，Tier 2 加 OTel，Tier 3 侵入改造暴露 experiment flags。每档买到什么、什么时候升级。\"\n---\n\nimport { TierLadder } from '/snippets/diagram-tier-ladder.jsx';\n\n接入 [NiceEval](https://niceeval.com/) 不是全有或全无的一次性工程。按「Adapter 接到哪里、额外拿到什么观测数据」，接入分三级——每一级在上一级之上加一种投入、换一组新能力，已写的评估用例全程复用，不用改。\n\n<TierLadder />\n\n## Tier 1：只接 send\n\n应用代码一行不改，接入只有一个 Adapter 文件——`send` 对着用户前端本来就在用的那个接口收发。\n\n**全套断言都在这一档**：文本断言与 judge、结构化输出校验、多轮与会话隔离、HITL 审批流、事件映射给到的工具断言，以及 `send` 返回 usage 带来的用量断言——判定依据全部来自 `send` 返回的 `Turn`，后面两档不会再多出任何断言。应用接口本身暴露模型选择的话，**模型对比** experiment 也在这一档——experiment 的 `model` 经 `ctx.model` 传给 Adapter，随请求转发即可。\n\n大多数团队从这里开始，很多也停在这里就够了。\n\n## Tier 2：send + OTel\n\n还是同一个 `send`、同一套事件映射，只是让应用把 OTel span 也发给 [NiceEval](https://niceeval.com/) 一份。应用已埋点（AI SDK telemetry、LangGraph、OpenLLMetry / OpenInference、自埋 gen_ai）就零改动。没埋点补的是一段通用 OTel 初始化——这属于可观测性建设，不是为评估用例定制的改造。\n\n这一档买到的是**观测**：`niceeval view` 的调用瀑布图——应用内部每次模型调用、每次工具执行、各自的耗时与 token，按轮铺成时间线。断言不受影响：span 只进瀑布图，不进事件流、不喂断言。走法见[OTel 接入](/zh/tutorials/connect-otel)。\n\n## Tier 3：侵入改造 + experiment flags\n\n要评「改 prompt / 换工具集 / 开关某个 feature 谁更好」这类 **feature A/B test** 时，对照点在应用内部，前两档拿不到。这一档改应用内部代码，把变体暴露成外部可选的配置：experiment 的 `flags` 经 `ctx.flags` 透传给 Adapter，Adapter 随请求交给应用（HTTP header、请求体字段、环境变量都行），应用按参数切换变体。\n\n注意侵入的是应用（把变体暴露成配置），不是接入面——Adapter 本身不变，依然只经对外接口调用应用。\n\n## 无侵入是前两档的底线\n\n前两档都是**无侵入**的：应用由你按它自己的方式启动（`pnpm start`、部署在哪都行），评估侧不 spawn 应用进程、不另开端口——Adapter 只对着**用户前端本来就在用的那个接口**（HTTP 端点、SSE 流）收发，连不上时报\"先起应用\"的明确错误。两档的区别只在观测数据：Tier 1 只有 `send` 返回的事件，Tier 2 多一份发给 [NiceEval](https://niceeval.com/) 的 span、瀑布图随之出现。\n\n## 怎么升级\n\n三级递进不互斥：先用 Tier 1 跑通基线和模型对比。要调用瀑布图，升 Tier 2。要对照应用内部变体，再升 Tier 3。每次升级都只是给 Adapter 或应用加东西，experiment 侧怎么组织对比见[实验](/zh/explanation/experiment)。\n\n## 相关阅读\n\n- [接入你的 Agent](/zh/tutorials/connect-your-agent) — 接入全景：最小接入与参数通道。\n- [Adapter](/zh/explanation/adapter) — 契约本身：`send` 传入什么返回什么，`ctx.model` / `ctx.telemetry` / `ctx.flags` 按档位出现。\n- [OTel 接入](/zh/tutorials/connect-otel) — Tier 2 的完整走法。\n- [实验](/zh/explanation/experiment) — model / flags 对比在 experiment 侧怎么声明。\n{\n  \"name\": \"niceeval\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"type\": \"module\",\n  \"devDependencies\": {\n    \"niceeval\": \"0.13.2-canary.35\"\n  }\n}\n{\n  \"name\": \"niceeval\",\n  \"version\": \"1.0.0\",\n  \"lockfileVersion\": 3,\n  \"requires\": true,\n  \"packages\": {\n    \"\": {\n      \"name\": \"niceeval\",\n      \"version\": \"1.0.0\",\n      \"license\": \"ISC\",\n      \"devDependencies\": {\n        \"niceeval\": \"0.13.2-canary.35\"\n      }\n    },\n    \"node_modules/@antfu/install-pkg\": {\n      \"version\": \"1.1.0\",\n      \"resolved\": \"https://registry.npmjs.org/@antfu/