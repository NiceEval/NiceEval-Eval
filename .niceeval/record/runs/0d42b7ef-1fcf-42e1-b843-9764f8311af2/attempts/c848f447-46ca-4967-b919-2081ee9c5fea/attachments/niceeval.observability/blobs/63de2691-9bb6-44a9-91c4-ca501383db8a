
// ./scripts/build-e2b-template.ts
import { Template } from "e2b";
import { e2bCodingAgentTemplate } from "niceeval/sandbox/e2b-template";
import { E2B_TEMPLATE } from "../experiments/codex/sandbox.ts";

async function main() {
  const template = e2bCodingAgentTemplate("codex")
    .aptInstall(["nodejs", "npm"])
    .copy("package.json", "/opt/express-deps/package.json")
    .copy("package-lock.json", "/opt/express-deps/package-lock.json")
    .runCmd("cd /opt/express-deps && npm ci --ignore-scripts");

  await Template.build(template, E2B_TEMPLATE, {
    cpuCount: 2,
    memoryMB: 4096,
  });
}

main().catch(function (error) {
  console.error(error);
  process.exitCode = 1;
});

