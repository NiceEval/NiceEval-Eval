// ./agents/gpt-researcher.ts
import { defineAgent } from "niceeval/adapter";

type ServerFrame = {
  type?: string;
  content?: unknown;
  output?: unknown;
};

const websocketEvidence = {
  events: {
    status: "partial" as const,
    reason: "The server emits progress frames but does not expose a complete ordered event stream.",
  },
  actions: {
    status: "unavailable" as const,
    reason: "The WebSocket protocol does not expose tool lifecycle events.",
  },
  messages: { status: "complete" as const },
  usage: {
    status: "unavailable" as const,
    reason: "The WebSocket protocol does not return token or cost usage.",
  },
  status: { status: "complete" as const },
  data: {
    status: "unavailable" as const,
    reason: "The WebSocket protocol does not return structured report data.",
  },
};

export function gptResearcherAgent(options: { baseUrl: string }) {
  const wsUrl = options.baseUrl.replace(/^http/, "ws").replace(/\/$/, "") + "/ws";

  return defineAgent({
    name: "gpt-researcher-websocket",
    evidenceCoverage: websocketEvidence,
    async send(input, ctx) {
      ctx.progress({ message: "Connecting to GPT Researcher" });
      const socket = new WebSocket(wsUrl);
      const report = await new Promise<string>((resolve, reject) => {
        const abort = () => {
          socket.close();
          reject(new Error("GPT Researcher request aborted"));
        };
        ctx.signal.addEventListener("abort", abort, { once: true });

        socket.addEventListener("open", () => {
          socket.send(`start ${JSON.stringify({
            task: input.text,
            report_type: "research_report",
            report_source: "local",
            source_urls: [],
            document_urls: [],
            tone: "Objective",
            query_domains: [],
            max_search_results: 1,
          })}`);
        });
        socket.addEventListener("message", (event) => {
          if (event.data === "pong") return;
          let frame: ServerFrame;
          try {
            frame = JSON.parse(String(event.data)) as ServerFrame;
          } catch {
            return;
          }
          if (frame.type === "logs") {
            if (frame.content === "error") {
              socket.close();
              reject(new Error(`GPT Researcher failed: ${String(frame.output ?? "unknown server error")}`));
              return;
            }
            ctx.progress({ message: `Researcher: ${String(frame.content ?? "working")}` });
            return;
          }
          if (frame.type === "report" && typeof frame.output === "string") {
            socket.close();
            resolve(frame.output);
          }
        });
        socket.addEventListener("error", () => reject(new Error(`Could not connect to GPT Researcher at ${wsUrl}. Start the service and retry.`)));
        socket.addEventListener("close", () => ctx.signal.removeEventListener("abort", abort));
      });

      return {
        status: "completed",
        events: [{ type: "message", role: "assistant", text: report }],
      };
    },
  });
}

