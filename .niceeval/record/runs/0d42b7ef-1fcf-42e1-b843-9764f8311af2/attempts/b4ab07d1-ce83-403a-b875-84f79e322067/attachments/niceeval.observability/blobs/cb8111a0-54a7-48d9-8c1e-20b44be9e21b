// ./evals/research/local-fixture.eval.ts
import { defineEval } from "niceeval";
import { includes, pattern } from "niceeval/expect";

export default [
  defineEval({
    description: "Produces a grounded local research report from the fixture brief",
    async test(t) {
      const turn = await t.send(
        "Write a short research report explaining the release cadence and the documented support window.",
      );
      turn.succeeded();
      t.check(turn.message, includes("monthly"));
      t.check(turn.message, pattern(/support window[\s\S]{0,80}18 months|18 months[\s\S]{0,80}support window/i));
    },
  }),
  defineEval({
    description: "Declines a factual claim absent from the local fixture",
    async test(t) {
      const turn = await t.send(
        "According to the local documents, what is the name of the CEO of Acme Research? If it is not documented, say that it is not available in the local documents.",
      );
      turn.succeeded();
      t.check(turn.message, pattern(/not (?:available|documented|provided)|cannot (?:determine|find)|do not (?:contain|include)/i));
    },
  }),
];
