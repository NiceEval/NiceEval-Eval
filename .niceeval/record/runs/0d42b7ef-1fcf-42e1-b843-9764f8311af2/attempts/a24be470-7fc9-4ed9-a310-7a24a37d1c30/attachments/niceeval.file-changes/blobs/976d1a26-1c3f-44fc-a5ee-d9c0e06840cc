import {
  chatCompletionEvidenceCoverage,
  defineAgent,
  turnFromChatCompletion,
} from "niceeval/adapter";
import type { Agent } from "niceeval/adapter";

type DbGptOptions = {
  baseUrl: string;
  apiKey?: string;
};

type DbGptError = {
  error?: { message?: string };
  detail?: { error?: { message?: string } };
};

export function dbGpt(options: DbGptOptions): Agent {
  return defineAgent({
    name: "dbgpt-chat-completions",
    evidenceCoverage: chatCompletionEvidenceCoverage,
    async send(input, ctx) {
      ctx.progress({ message: "waiting for DB-GPT chat completion" });
      const response = await fetch(`${options.baseUrl}/api/v2/chat/completions`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          ...(options.apiKey
            ? { authorization: `Bearer ${options.apiKey}` }
            : {}),
        },
        body: JSON.stringify({
          model: ctx.model,
          messages: [{ role: "user", content: input.text }],
          stream: false,
          incremental: false,
          conv_uid: ctx.session.id,
          chat_mode: "chat_normal",
        }),
        signal: ctx.signal,
      });

      const body = (await response.json()) as DbGptError;
      if (!response.ok) {
        const message = body.error?.message ?? body.detail?.error?.message;
        ctx.diagnostic({
          code: "dbgpt-chat-completion-failed",
          level: "error",
          message: `DB-GPT returned HTTP ${response.status}${message ? `: ${message}` : ""}`,
        });
        return { status: "failed", events: [] };
      }

      return turnFromChatCompletion(body);
    },
  });
}
