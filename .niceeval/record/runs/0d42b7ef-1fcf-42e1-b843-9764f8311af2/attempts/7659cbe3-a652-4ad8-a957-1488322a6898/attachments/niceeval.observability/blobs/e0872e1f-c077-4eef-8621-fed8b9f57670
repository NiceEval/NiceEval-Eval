// ./evals/unknown-memory.eval.ts
import { defineEval } from "niceeval";
import { pattern } from "niceeval/expect";

export default defineEval({
  description: "Does not fabricate a preference that was never provided",
  async test(t) {
    const turn = await t.send(
      "What deployment region did I say I prefer for the fictional Zephyr Vault project? I have never provided a preference for that project.",
    );

    turn.succeeded().label("memory query completed");
    t.check(turn.message, pattern(/(?:do not|don't|did not|haven't|no)\s+(?:know|have|information|record|preference)|not\s+(?:provided|available|known)/i)).label(
      "states that the unknown preference is unavailable",
    );
  },
});

// ./evals/memory-write.eval.ts
import { defineEval } from "niceeval";
import { pattern } from "niceeval/expect";

export default defineEval({
  description: "Stores a user preference in the Letta agent's long-term memory",
  async test(t) {
    const turn = await t.send(
      "Remember this durable preference for future conversations: my preferred deployment region is eu-west-1. Confirm the preference you stored.",
    );

    turn.succeeded().label("memory update completed");
    t.check(turn.message, pattern(/eu[ -]?west[ -]?1/i)).label("confirms the stored deployment region");
  },
});
