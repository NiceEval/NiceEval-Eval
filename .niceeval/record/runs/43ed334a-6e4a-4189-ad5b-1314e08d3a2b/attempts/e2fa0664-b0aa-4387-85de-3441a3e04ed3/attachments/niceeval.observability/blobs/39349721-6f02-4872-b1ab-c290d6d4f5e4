
// ./experiments/dbgpt-excel-local.ts
import { defineExperiment } from "niceeval";
import { dbGptExcel } from "../agents/dbgpt-excel.ts";

export default defineExperiment({
  description: "DB-GPT spreadsheet analysis baseline against the local service",
  agent: dbGptExcel({
    baseUrl: "http://localhost:5670",
    fixturePath: "../docker/examples/excel/Walmart_Sales.csv",
  }),
  // This is the model name in configs/dbgpt-proxy-ollama.toml. It must be
  // available from that configured DB-GPT service before this experiment runs.
  model: "deepseek-r1:1.5b",
  attempts: 1,
