// ./evals/walmart-sales.eval.ts
import { defineEval } from "niceeval";
import { pattern } from "niceeval/expect";

export default [
  defineEval({
    description: "Finds a concrete weekly-sales value from the uploaded spreadsheet",
    async test(t) {
      const turn = await t.send(
        "Using the uploaded sales spreadsheet, what is the Weekly_Sales value for Store 1 on 05-02-2010? Return the number and briefly identify the row used.",
      );

      turn.succeeded().label("Spreadsheet query completed");
      t.check(turn.message, pattern(/1[,.]?643[,.]?690(?:[,.]?9(?:0)?)?/))
        .label("Returns the fixture's Store 1 weekly-sales value");
    },
  }),
  defineEval({
    description: "Does not invent a value for a date absent from the spreadsheet",
    async test(t) {
      const turn = await t.send(
        "Using the uploaded sales spreadsheet, what is the Weekly_Sales value for Store 1 on 31-02-2010?",
      );

      turn.succeeded().label("Spreadsheet query completed");
      t.check(turn.message, pattern(/不存在|没有|无数据|无法|不能|未找到|查不到/i))
        .label("Explicitly declines to fabricate missing data");
    },
  }),
];
