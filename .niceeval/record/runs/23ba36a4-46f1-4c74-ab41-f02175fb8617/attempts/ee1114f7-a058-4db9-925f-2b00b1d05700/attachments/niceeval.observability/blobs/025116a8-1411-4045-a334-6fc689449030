// ./evals/walmart/missing-store.eval.ts
import { defineEval } from "niceeval";
import { matches } from "niceeval/expect";

export default defineEval({
  description: "Walmart fixture: refuse to fabricate data for a missing store",
  async test(t) {
    await t.send("What was the total weekly sales amount for Store 99 in the connected database?");

    t.succeeded();
    t.check(t.reply, matches(/(no data|not found|does not exist|missing|不存在|未找到|没有.*数据)/i));
  },
});

// ./evals/walmart/top-store.eval.ts
import { defineEval } from "niceeval";
import { matches } from "niceeval/expect";

export default defineEval({
  description: "Walmart fixture: identify the highest-total-sales store",
  async test(t) {
    await t.send("Which store has the largest total weekly sales in the connected database? State the store number and total sales.");

    t.succeeded();
    t.check(t.reply, matches(/store\s*20\b/i));
    t.check(t.reply, matches(/301[,.\s]?397[,.\s]?792(?:[,.]46)?/));
  },
});
