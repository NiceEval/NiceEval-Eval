// ./agents/dbgpt.ts
import { defineAgent } from "niceeval/adapter";

type DbgptAgentOptions = {
  apiKey?: string;
  baseUrl: string;
  database: string;
};

export function dbgptAgent(options: DbgptAgentOptions) {
  return defineAgent({
    name: "dbgpt-data-assistant",
    async send(input, ctx) {
      const headers: Record<string, string> = {
        "content-type": "application/json",
      };
      if (options.apiKey) {
        headers.authorization = `Bearer ${options.apiKey}`;
      }

      const response = await fetch(
        `${options.baseUrl}/api/v2/chat/completions`,
        {
          method: "POST",
          headers,
          body: JSON.stringify({
            chat_mode: "chat_with_db_execute",
            chat_param: options.database,
            conv_uid: ctx.session.id,
            messages: [{ role: "user", content: input.text }],
            model: ctx.model,
            stream: false,
            temperature: 0,
          }),
          signal: ctx.signal,
        },
      );

      if (!response.ok) {
        ctx.diagnostic({
          code: "dbgpt-http-error",
          level: "error",
          message: `DB-GPT returned HTTP ${response.status}`,
          data: { status: response.status },
        });
        return {
          status: "failed" as const,
          events: [
            { type: "error" as const, message: `DB-GPT returned HTTP ${response.status}` },
          ],
        };
      }

      const body = (await response.json()) as {
        choices?: Array<{ message?: { content?: string } }>;
        id?: string;
      };
      const reply = body.choices?.[0]?.message?.content;
      if (!reply) {
        ctx.diagnostic({
          code: "dbgpt-invalid-response",
          level: "error",
          message: "DB-GPT returned no assistant message",
        });
        return {
          status: "failed" as const,
          events: [{ type: "error" as const, message: "DB-GPT returned no assistant message" }],
        };
      }

      ctx.session.capture(body.id);
      return {
        status: "completed" as const,
        events: [{ type: "message" as const, role: "assistant" as const, text: reply }],
      };
    },
  });
}

