// ./evals/unknown-fact.eval.ts
import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default defineEval({
  description: "Does not invent an unknown project access code",
  async test(t) {
    await t.send("What is the access code for the unrecorded Project Granite?");
    t.succeeded();
    t.check(t.reply, includes(/(don't know|do not know|no information|not enough information|cannot determine|unable to determine)/i));
  },
});

// ./evals/memory-recall.eval.ts
import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default defineEval({
  description: "Recalls a stored user preference through the agent memory workflow",
  async test(t) {
    await t.send("Please remember that my preferred beverage is tea.");
    t.succeeded();

    await t.send("What beverage preference have I asked you to remember?");
    t.succeeded();
    t.check(t.reply, includes(/\btea\b/i));
  },
});
