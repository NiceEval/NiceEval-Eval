import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default defineEval({
  description: "Recalls a stored user preference through the agent memory workflow",
  async test(t) {
    await t.send("Please remember that my preferred beverage is tea.");
    t.succeeded();

    await t.send("What beverage preference have I asked you to remember?");
    t.succeeded();
    t.check(t.reply, includes(/\btea\b/i));
  },
});
