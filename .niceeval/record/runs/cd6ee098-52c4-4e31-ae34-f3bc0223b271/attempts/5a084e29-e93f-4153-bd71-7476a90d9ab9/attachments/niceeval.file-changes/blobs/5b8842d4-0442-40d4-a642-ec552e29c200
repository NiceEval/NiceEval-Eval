import { defineDirectAgent } from "niceeval/adapter";
import type { Agent } from "niceeval/adapter";

type ReportResponse = {
  report?: unknown;
  detail?: unknown;
  error?: unknown;
};

export function gptResearcher(options: { baseUrl: string }): Agent {
  return defineDirectAgent({
    name: "gpt-researcher-local",
    evidenceCoverage: {
      events: {
        status: "partial",
        reason: "The HTTP API returns the final report rather than its internal event stream.",
      },
      actions: {
        status: "unavailable",
        reason: "The HTTP API does not expose research tool calls or their lifecycle.",
      },
      messages: { status: "complete" },
      usage: {
        status: "partial",
        reason: "The API response may contain aggregate costs but not token usage for every operation.",
      },
      status: { status: "complete" },
      data: {
        status: "partial",
        reason: "Only the report response is returned; intermediate research output is not exposed.",
      },
    },
    async send(input, ctx) {
      ctx.progress({ message: "Requesting a local-source research report" });
      const response = await fetch(`${options.baseUrl}/report/`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          task: input.text,
          report_type: "research_report",
          report_source: "local",
          tone: "Objective",
          repo_name: "niceeval-fixture",
          branch_name: "main",
          generate_in_background: false,
        }),
        signal: ctx.signal,
      });

      const body = (await response.json()) as ReportResponse;
      const report = typeof body.report === "string" ? body.report : "";
      if (!response.ok || !report.trim()) {
        const detail = typeof body.detail === "string" ? body.detail : body.error;
        ctx.diagnostic({
          code: "report-request-failed",
          level: "error",
          message: typeof detail === "string" ? detail : "The report API returned no report.",
        });
      }

      return {
        status: response.ok && report.trim() ? "completed" : "failed",
        events: report
          ? [{ type: "message", role: "assistant", text: report }]
          : [],
        data: body,
      };
    },
  });
}
