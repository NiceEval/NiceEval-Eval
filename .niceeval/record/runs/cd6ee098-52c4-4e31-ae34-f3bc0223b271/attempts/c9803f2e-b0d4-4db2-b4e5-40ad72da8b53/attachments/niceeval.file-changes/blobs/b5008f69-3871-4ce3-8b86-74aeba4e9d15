import { defineDirectAgent } from "niceeval/adapter";
import type { StreamEvent } from "niceeval";

const DEFAULT_BASE_URL = "http://127.0.0.1:3000/api/v1";
const POLL_INTERVAL_MS = 1_000;
const START_TIMEOUT_MS = 120_000;
const RESPONSE_IDLE_MS = 8_000;

type StartTask = {
  status: "READY" | "ERROR" | string;
  detail?: string;
  app_conversation_id?: string;
};

type OpenHandsEvent = {
  id?: string;
  kind?: string;
  source?: string;
  content?: unknown;
  message?: string;
  action?: string;
  observation?: string;
  timestamp?: string;
  [key: string]: unknown;
};

function textFrom(value: unknown): string | undefined {
  if (typeof value === "string") return value;
  if (Array.isArray(value)) {
    return value
      .map((item) => textFrom(item))
      .filter((item): item is string => Boolean(item))
      .join("\n") || undefined;
  }
  if (value && typeof value === "object") {
    const record = value as Record<string, unknown>;
    return textFrom(record.text ?? record.content ?? record.message);
  }
  return undefined;
}

function mapEvents(events: OpenHandsEvent[]): StreamEvent[] {
  const mapped: StreamEvent[] = [];
  const openOperations = new Set<string>();

  for (const event of events) {
    const kind = String(event.kind ?? event.source ?? "").toLowerCase();
    const id = String(event.id ?? `${mapped.length}`);
    const text = textFrom(event.content ?? event.message);

    if (kind.includes("message") && text) {
      const role = kind.includes("user") ? "user" : "assistant";
      mapped.push({ type: "message", role, text });
      continue;
    }

    if (kind.includes("action")) {
      const name = String(event.action ?? event.tool ?? "unknown");
      mapped.push({
        type: "operation.started",
        operationId: id,
        operation: { kind: "tool", name, input: event },
      });
      openOperations.add(id);
      continue;
    }

    if (kind.includes("observation") && openOperations.size > 0) {
      const operationId = [...openOperations].at(-1)!;
      mapped.push({
        type: "operation.finished",
        operationId,
        kind: "tool",
        output: event.observation ?? event.content ?? event,
        status: "completed",
      });
      openOperations.delete(operationId);
    }
  }

  return mapped;
}

async function sleep(ms: number, signal: AbortSignal) {
  await new Promise<void>((resolve, reject) => {
    const timer = setTimeout(resolve, ms);
    signal.addEventListener("abort", () => {
      clearTimeout(timer);
      reject(signal.reason);
    }, { once: true });
  });
}

export function openhandsAgent(baseUrl = process.env.OPENHANDS_BASE_URL ?? DEFAULT_BASE_URL) {
  return defineDirectAgent({
    name: "openhands-app-server",
    evidenceCoverage: {
      events: { status: "partial", reason: "Only persisted app-server events are available." },
      actions: { status: "partial", reason: "Action/observation pairing is inferred from persisted events." },
      messages: { status: "complete" },
      usage: { status: "unavailable", reason: "The app-server event API does not expose per-turn usage." },
      status: { status: "partial", reason: "Completion is inferred after the event stream becomes idle." },
      data: { status: "unavailable", reason: "OpenHands returns an event stream rather than structured turn data." },
    },
    async send(input, ctx) {
      let conversationId = ctx.session.id;

      if (!conversationId) {
        ctx.progress({ message: "Starting OpenHands conversation" });
        const startResponse = await fetch(`${baseUrl}/app-conversations`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ llm_model: ctx.model }),
          signal: ctx.signal,
        });
        if (!startResponse.ok) throw new Error(`OpenHands start failed: ${startResponse.status} ${await startResponse.text()}`);

        const startTask = await startResponse.json() as { id: string };
        const deadline = Date.now() + START_TIMEOUT_MS;
        while (Date.now() < deadline) {
          await sleep(POLL_INTERVAL_MS, ctx.signal);
          const taskResponse = await fetch(`${baseUrl}/app-conversations/start-tasks?ids=${startTask.id}`, { signal: ctx.signal });
          if (!taskResponse.ok) throw new Error(`OpenHands start status failed: ${taskResponse.status}`);
          const [task] = await taskResponse.json() as Array<StartTask | null>;
          if (!task) throw new Error("OpenHands did not return the conversation start task.");
          if (task.status === "ERROR") throw new Error(`OpenHands conversation startup failed: ${task.detail ?? "unknown error"}`);
          if (task.status === "READY" && task.app_conversation_id) {
            conversationId = task.app_conversation_id;
            ctx.session.capture(conversationId);
            break;
          }
        }
        if (!conversationId) throw new Error("OpenHands conversation startup timed out.");
      }

      const before = await fetch(`${baseUrl}/conversation/${conversationId}/events/search?limit=100`, { signal: ctx.signal });
      if (!before.ok) throw new Error(`OpenHands event lookup failed: ${before.status}`);
      const previousEvents = (await before.json() as { items: OpenHandsEvent[] }).items;
      const previousIds = new Set(previousEvents.map((event) => event.id));

      const sendResponse = await fetch(`${baseUrl}/app-conversations/${conversationId}/send-message`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ role: "user", content: [{ type: "text", text: input.text }], run: true }),
        signal: ctx.signal,
      });
      if (!sendResponse.ok) throw new Error(`OpenHands message failed: ${sendResponse.status} ${await sendResponse.text()}`);

      ctx.progress({ message: "Waiting for OpenHands response" });
      let latest: OpenHandsEvent[] = [];
      let lastChange = Date.now();
      while (Date.now() - lastChange < RESPONSE_IDLE_MS) {
        await sleep(POLL_INTERVAL_MS, ctx.signal);
        const eventsResponse = await fetch(`${baseUrl}/conversation/${conversationId}/events/search?limit=100`, { signal: ctx.signal });
        if (!eventsResponse.ok) throw new Error(`OpenHands event polling failed: ${eventsResponse.status}`);
        const items = (await eventsResponse.json() as { items: OpenHandsEvent[] }).items;
        const next = items.filter((event) => !previousIds.has(event.id));
        if (next.length !== latest.length) lastChange = Date.now();
        latest = next;
      }

      const events = mapEvents(latest);
      if (!events.some((event) => event.type === "message" && event.role === "assistant")) {
        throw new Error("OpenHands completed without a persisted assistant message.");
      }
      return { status: "completed", events };
    },
  });
}

export default openhandsAgent();
