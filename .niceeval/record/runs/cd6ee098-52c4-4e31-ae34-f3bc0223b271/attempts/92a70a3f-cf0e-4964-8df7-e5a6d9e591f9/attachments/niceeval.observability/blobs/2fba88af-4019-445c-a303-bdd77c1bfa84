// ./agents/letta.ts
import { completeEvidenceCoverage, defineDirectAgent } from "niceeval/adapter";

type LettaMessage = {
  message_type: string;
  content?: string | unknown[];
  reasoning?: string;
  tool_call?: LettaToolCall;
  tool_calls?: LettaToolCall[] | LettaToolCall;
  tool_return?: unknown;
  tool_returns?: LettaToolReturn[];
  status?: "success" | "error";
  tool_call_id?: string;
};

type LettaToolCall = {
  name?: string;
  arguments?: string;
  tool_call_id?: string;
};

type LettaToolReturn = {
  tool_return?: unknown;
  status?: "success" | "error";
  tool_call_id?: string;
};

type LettaResponse = {
  messages?: LettaMessage[];
  stop_reason?: { stop_reason?: string };
  usage?: {
    prompt_tokens?: number;
    completion_tokens?: number;
    cached_input_tokens?: number;
    cache_write_tokens?: number;
    reasoning_tokens?: number;
  };
  error?: { message?: string };
};

function asArray<T>(value: T | T[] | undefined): T[] {
  return value === undefined ? [] : Array.isArray(value) ? value : [value];
}

function jsonValue(value: string | undefined): unknown {
  if (!value) return {};
  try {
    return JSON.parse(value);
  } catch {
    return { raw: value };
  }
}

function text(value: string | unknown[] | undefined): string {
  return typeof value === "string" ? value : value ? JSON.stringify(value) : "";
}

export function lettaAgent(options: { baseUrl: string; agentId: string }) {
  const baseUrl = options.baseUrl.replace(/\/$/, "");

  return defineDirectAgent({
    name: "letta-agent",
    evidenceCoverage: completeEvidenceCoverage,
    async send(input, ctx) {
      ctx.progress({ message: "Sending a message to Letta" });
      const response = await fetch(`${baseUrl}/v1/agents/${options.agentId}/messages`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          input: input.text,
          streaming: false,
          override_model: ctx.model,
        }),
        signal: ctx.signal,
      });
      const body = (await response.json()) as LettaResponse;

      if (!response.ok) {
        return {
          status: "failed" as const,
          events: [{ type: "error" as const, message: body.error?.message ?? `Letta returned HTTP ${response.status}` }],
        };
      }

      const events = [] as Array<Record<string, unknown>>;
      for (const message of body.messages ?? []) {
        if (message.message_type === "reasoning_message" && message.reasoning) {
          events.push({ type: "thinking", text: message.reasoning });
        }
        if (message.message_type === "assistant_message") {
          events.push({ type: "message", role: "assistant", text: text(message.content) });
        }
        if (message.message_type === "tool_call_message") {
          for (const call of asArray(message.tool_calls ?? message.tool_call)) {
            if (!call.tool_call_id || !call.name) continue;
            events.push({
              type: "operation.started",
              operationId: call.tool_call_id,
              operation: { kind: "tool", name: call.name, input: jsonValue(call.arguments) },
            });
          }
        }
        if (message.message_type === "tool_return_message") {
          const returns = message.tool_returns ?? [message];
          for (const result of returns) {
            const operationId = result.tool_call_id;
            if (!operationId) continue;
            events.push({
              type: "operation.finished",
              operationId,
              kind: "tool",
              output: result.tool_return,
              status: result.status === "error" ? "failed" : "completed",
            });
          }
        }
      }

      const stopReason = body.stop_reason?.stop_reason;
      const failed = stopReason !== undefined && !["end_turn", "max_steps", "tool_rule", "requires_approval"].includes(stopReason);
      return {
        status: failed ? ("failed" as const) : ("completed" as const),
        events,
        usage: body.usage
          ? {
              inputTokens: body.usage.prompt_tokens,
              outputTokens: body.usage.completion_tokens,
              cacheReadTokens: body.usage.cached_input_tokens,
              cacheCreationTokens: body.usage.cache_write_tokens,
              reasoningTokens: body.usage.reasoning_tokens,
            }
          : undefined,
      };
    },
  });
}

