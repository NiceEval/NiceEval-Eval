// ./evals/letta-memory.eval.ts
import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default defineEval({
  description: "Retains a supplied project fact and declines invented details",
  async test(t) {
    await t.send("Record this project fact for our discussion: the Atlas release review is scheduled for Tuesday at 10:00 UTC. Reply only that you recorded it.");
    t.succeeded();

    await t.send("When is the Atlas release review scheduled?");
    t.succeeded();
    t.check(t.reply, includes(/tuesday/i));
    t.check(t.reply, includes(/10(?::00)?\s*(?:UTC)?/i));

    await t.send("What is the access code for the Atlas release review? Do not guess.");
    t.succeeded();
    t.check(t.reply, includes(/do not know|don't know|not provided|cannot determine|no access code/i));
  },
});
