// @file ./agents/letta.ts
import { defineDirectAgent } from "niceeval/adapter";
import type { EvidenceCoverage } from "niceeval/adapter";

type JsonObject = Record<string, unknown>;

interface LettaOptions {
  baseUrl: string;
  agentId: string;
  apiKey?: string;
}

const evidenceCoverage: EvidenceCoverage = {
  events: { status: "partial", reason: "The non-streaming Letta response may omit intermediate agent events." },
  actions: { status: "partial", reason: "Letta returns completed tool calls but does not expose every lifecycle transition." },
  messages: { status: "complete" },
  usage: { status: "complete" },
  status: { status: "complete" },
  data: { status: "unavailable", reason: "Letta's message endpoint returns conversational events, not a structured result." },
};

function asObject(value: unknown): JsonObject {
  return value !== null && typeof value === "object" && !Array.isArray(value) ? value as JsonObject : {};
}

function text(value: unknown): string {
  if (typeof value === "string") return value;
  if (Array.isArray(value)) return value.map(text).filter(Boolean).join("\n");
  const part = asObject(value);
  return typeof part.text === "string" ? part.text : typeof part.content === "string" ? part.content : "";
}

function json(value: unknown): string | number | boolean | null | JsonObject | unknown[] {
  if (value === null || typeof value === "string" || typeof value === "number" || typeof value === "boolean") return value;
  if (Array.isArray(value)) return value;
  return asObject(value);
}

function toolCalls(message: JsonObject): JsonObject[] {
  const calls = message.tool_calls ?? message.tool_call;
  return Array.isArray(calls) ? calls.map(asObject) : calls ? [asObject(calls)] : [];
}

function parseArguments(value: unknown): ReturnType<typeof json> {
  if (typeof value !== "string") return json(value);
  try {
    return json(JSON.parse(value));
  } catch {
    return value;
  }
}

export function lettaAgent(options: LettaOptions) {
  const baseUrl = options.baseUrl.replace(/\/$/, "");

  return defineDirectAgent({
    name: "letta-rest-agent",
    evidenceCoverage,
    async send(input, ctx) {
      const response = await fetch(`${baseUrl}/v1/agents/${options.agentId}/messages`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          ...(options.apiKey ? { authorization: `Bearer ${options.apiKey}` } : {}),
        },
        body: JSON.stringify({ input: input.text, override_model: ctx.model }),
        signal: ctx.signal,
      });

      if (!response.ok) {
        throw new Error(`Letta message request failed: ${response.status} ${response.statusText}`);
      }

      const body = asObject(await response.json());
      const events: object[] = [];
      const startedTools = new Set<string>();

      for (const value of Array.isArray(body.messages) ? body.messages : []) {
        const message = asObject(value);
        const messageType = message.message_type;

        if (message.is_err === true) {
          events.push({ type: "error", message: text(message.content) || "Letta returned an error message." });
        }

        if (messageType === "assistant_message") {
          const reply = text(message.content);
          if (reply) events.push({ type: "message", role: "assistant", text: reply });
        } else if (messageType === "reasoning_message") {
          const reasoning = text(message.reasoning ?? message.content);
          if (reasoning) events.push({ type: "thinking", text: reasoning });
        } else if (messageType === "tool_call_message") {
          for (const call of toolCalls(message)) {
            const operationId = String(call.tool_call_id ?? message.id);
            startedTools.add(operationId);
            events.push({
              type: "operation.started",
              operationId,
              operation: { kind: "tool", name: String(call.name ?? "unknown"), input: parseArguments(call.arguments) },
            });
          }
        } else if (messageType === "tool_return_message") {
          const operationId = String(message.tool_call_id ?? message.id);
          if (!startedTools.has(operationId)) {
            events.push({
              type: "operation.started",
              operationId,
              operation: { kind: "tool", name: "unknown", input: {} },
            });
          }
          events.push({
            type: "operation.finished",
            operationId,
            kind: "tool",
            output: json(message.tool_return),
            status: message.status === "error" ? "failed" : "completed",
          });
        }
      }

      const usage = asObject(body.usage);
      return {
        status: "completed" as const,
        events,
        usage: {
          inputTokens: typeof usage.prompt_tokens === "number" ? usage.prompt_tokens : undefined,
          outputTokens: typeof usage.completion_tokens === "number" ? usage.completion_tokens : undefined,
          cacheReadTokens: typeof usage.cached_input_tokens === "number" ? usage.cached_input_tokens : undefined,
          cacheCreationTokens: typeof usage.cache_write_tokens === "number" ? usage.cache_write_tokens : undefined,
          reasoningTokens: typeof usage.reasoning_tokens === "number" ? usage.reasoning_tokens : undefined,
        },
      };
    },
  });
}
