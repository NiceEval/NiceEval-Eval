import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";
import { skyvernTaskInput } from "../agents/skyvern-task.ts";

const exampleDomainUrl = "https://example.com";

export default [
  defineEval({
    description: "Extracts a page heading from a browser task",
    async test(t) {
      await t.send(
        skyvernTaskInput({
          url: exampleDomainUrl,
          prompt: "Read the page heading and return it in the requested extraction field.",
          dataExtractionSchema: {
            type: "object",
            properties: { heading: { type: "string" } },
            required: ["heading"],
          },
        }),
      );

      t.succeeded();
      t.check(t.reply, includes(/example\s+domain/i));
    },
  }),
  defineEval({
    description: "Does not invent a telephone number absent from a page",
    async test(t) {
      await t.send(
        skyvernTaskInput({
          url: exampleDomainUrl,
          prompt: "Find the page's explicitly published telephone number. Return null when none exists.",
          dataExtractionSchema: {
            type: "object",
            properties: { telephone_number: { type: ["string", "null"] } },
            required: ["telephone_number"],
          },
        }),
      );

      t.succeeded();
      t.check(t.reply, includes(/"telephone_number"\s*:\s*null/i));
    },
  }),
];
