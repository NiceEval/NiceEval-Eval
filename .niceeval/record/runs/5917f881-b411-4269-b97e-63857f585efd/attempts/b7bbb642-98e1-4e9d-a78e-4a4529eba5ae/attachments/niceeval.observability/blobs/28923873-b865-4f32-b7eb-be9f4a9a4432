// ./agents/skyvern-task.ts
import { defineDirectAgent } from "niceeval/adapter";
import type { Agent, EvidenceCoverage } from "niceeval/adapter";

type SkyvernEngine = "skyvern-1.0" | "skyvern-2.0";

type SkyvernTaskInput = {
  url: string;
  prompt: string;
  dataExtractionSchema: Record<string, unknown>;
};

type SkyvernTaskResponse = {
  status?: string;
  output?: unknown;
  failure_reason?: string;
  run_id?: string;
};

type SkyvernTaskAgentOptions = {
  apiKey?: string;
  baseUrl: string;
  engine: SkyvernEngine;
};

const evidenceCoverage = {
  events: { status: "partial", reason: "Skyvern returns only the completed task result." },
  actions: { status: "unavailable", reason: "The task-run API does not expose action lifecycles." },
  messages: { status: "complete" },
  usage: { status: "unavailable", reason: "The task-run API does not return model usage." },
  status: { status: "complete" },
  data: { status: "complete" },
} satisfies EvidenceCoverage;

export function skyvernTaskInput(input: SkyvernTaskInput): string {
  return JSON.stringify(input);
}

function parseTaskInput(text: string): SkyvernTaskInput {
  const parsed = JSON.parse(text) as Partial<SkyvernTaskInput>;
  if (!parsed.url || !parsed.prompt || !parsed.dataExtractionSchema) {
    throw new Error("Skyvern eval input must contain url, prompt, and dataExtractionSchema.");
  }
  return parsed as SkyvernTaskInput;
}

function messageText(response: SkyvernTaskResponse): string {
  if (response.output !== undefined && response.output !== null) {
    return typeof response.output === "string" ? response.output : JSON.stringify(response.output);
  }
  return response.failure_reason ?? "Skyvern returned no task output.";
}

export function skyvernTaskAgent(options: SkyvernTaskAgentOptions): Agent {
  const baseUrl = options.baseUrl.replace(/\/$/, "");

  return defineDirectAgent({
    name: `skyvern-task-${options.engine}`,
    evidenceCoverage,
    async send(input, ctx) {
      const task = parseTaskInput(input.text);
      ctx.progress({ message: "Running Skyvern browser task" });

      const response = await fetch(`${baseUrl}/v1/run/tasks`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          ...(options.apiKey ? { "x-api-key": options.apiKey } : {}),
        },
        body: JSON.stringify({
          prompt: task.prompt,
          url: task.url,
          engine: options.engine,
          data_extraction_schema: task.dataExtractionSchema,
        }),
        signal: ctx.signal,
      });

      const body = (await response.json()) as SkyvernTaskResponse;
      if (!response.ok) {
        ctx.diagnostic({
          code: "skyvern-task-request-failed",
          level: "error",
          message: `Skyvern returned HTTP ${response.status}.`,
          data: { runId: body.run_id },
        });
      }

      const status = response.ok && body.status === "completed" ? "completed" : "failed";
      return {
        status,
        data: body.output ?? null,
        events: [{ type: "message", role: "assistant", text: messageText(body) }],
      };
    },
  });
}

