// ./agents/dbgpt-v2.ts
import { defineDirectAgent, type Agent, type EvidenceCoverage } from "niceeval/adapter";

const evidenceCoverage = {
  events: {
    status: "partial",
    reason: "DB-GPT V2 emits answer deltas but not a complete event history.",
  },
  actions: {
    status: "unavailable",
    reason: "DB-GPT V2 does not expose database or tool lifecycle events in this stream.",
  },
  messages: { status: "complete" },
  usage: {
    status: "partial",
    reason: "Usage is included only when the upstream stream supplies it.",
  },
  status: { status: "complete" },
  data: {
    status: "unavailable",
    reason: "The selected endpoint returns prose rather than a structured business result.",
  },
} satisfies EvidenceCoverage;

type DbGptAgentOptions = {
  baseUrl: string;
  database: string;
};

type ChatChunk = {
  choices?: Array<{ delta?: { content?: string }; message?: { content?: string } }>;
  usage?: { prompt_tokens?: number; completion_tokens?: number };
  error?: { message?: string };
};

export function dbGptV2Agent(options: DbGptAgentOptions): Agent {
  return defineDirectAgent({
    name: "dbgpt-v2-db-qa",
    evidenceCoverage,
    async send(input, ctx) {
      ctx.progress({ message: "Waiting for DB-GPT database QA" });
      const response = await fetch(`${options.baseUrl}/api/v2/chat/completions`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          model: ctx.model,
          messages: [{ role: "user", content: input.text }],
          stream: true,
          incremental: true,
          conv_uid: ctx.session.id,
          chat_mode: "chat_with_db_qa",
          chat_param: options.database,
        }),
        signal: ctx.signal,
      });

      if (!response.ok || !response.body) {
        throw new Error(`DB-GPT V2 request failed with HTTP ${response.status}`);
      }

      let reply = "";
      let failure: string | undefined;
      let usage: ChatChunk["usage"];
      const reader = response.body.pipeThrough(new TextDecoderStream()).getReader();
      let buffer = "";

      const consume = (block: string) => {
        for (const line of block.split("\n")) {
          if (!line.startsWith("data:")) continue;
          const data = line.slice(5).trim();
          if (!data || data === "[DONE]") continue;
          try {
            const chunk = JSON.parse(data) as ChatChunk;
            reply += chunk.choices?.[0]?.delta?.content ?? chunk.choices?.[0]?.message?.content ?? "";
            usage = chunk.usage ?? usage;
            failure ??= chunk.error?.message;
          } catch {
            failure ??= "DB-GPT returned a non-JSON SSE data frame.";
          }
        }
      };

      for (;;) {
        const { done, value } = await reader.read();
        buffer += value ?? "";
        let separator: number;
        while ((separator = buffer.indexOf("\n\n")) !== -1) {
          consume(buffer.slice(0, separator));
          buffer = buffer.slice(separator + 2);
        }
        if (done) break;
      }
      if (buffer.trim()) consume(buffer);

      if (failure) {
        return { status: "failed", events: [{ type: "error", message: failure }] };
      }
      if (!reply.trim()) {
        return {
          status: "failed",
          events: [{ type: "error", message: "DB-GPT completed without an assistant response." }],
        };
      }

      return {
        status: "completed",
        events: [{ type: "message", role: "assistant", text: reply }],
        usage: usage
          ? { inputTokens: usage.prompt_tokens, outputTokens: usage.completion_tokens }
          : undefined,
      };
    },
  });
}

