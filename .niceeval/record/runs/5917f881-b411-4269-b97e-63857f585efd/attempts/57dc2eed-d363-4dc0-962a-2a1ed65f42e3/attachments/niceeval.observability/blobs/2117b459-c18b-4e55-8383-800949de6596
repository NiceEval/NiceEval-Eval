// ./evals/db-qa/orders.eval.ts
import { defineEval } from "niceeval";
import { includes } from "niceeval/expect";

export default [
  defineEval({
    description: "Reports the completed-order total from the fixture database",
    async test(t) {
      await t.send("What is the total paid amount for completed orders?");
      t.succeeded();
      t.check(t.reply, includes(/(?:\$\s*)?175(?:\.0{1,2})?\b/));
    },
  }),
  defineEval({
    description: "Refuses to invent a result for a product absent from the fixture",
    async test(t) {
      await t.send("How many completed orders contain product Zebra-99?");
      t.succeeded();
      t.check(t.reply, includes(/(?:not found|no (?:matching )?(?:records?|orders?)|does not exist|unable to find)/i));
    },
  }),
];
