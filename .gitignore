node_modules/

# 候选包是每次运行现取的构建产物，不签入：签入 tarball 会让仓库随每次评估膨胀，
# 而它本来就能从 manifest.json 里的版本号复现
.candidate/

# 本仓库自己跑评估产生的结果；fixture 不携带历史 Record。
/.niceeval/
/.niceeval-local/

.DS_Store

# 本地密钥：被测目标应用（DB-GPT/GPT Researcher）自己要连的 LLM/数据源凭证。
# 只在跑 install eval 时由 sandbox setup 钩子读取并注入沙箱，不签入仓库。
.env

# agent 产出归档（saveAgentOutput 落盘，供人工 review，不进版本库）
.agent-output/
