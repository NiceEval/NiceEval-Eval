{
  "name": "niceeval-eval",
  "version": "1.0.0",
  "description": "niceeval 的文档效果评估仓库：用 niceeval 评估正在使用 niceeval 的 coding agent",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsx scripts/typecheck.ts",
    "install-eval": "niceeval exp install",
    "canary": "niceeval exp install/canary",
    "harness-eval": "niceeval exp harness",
    "experiment-eval": "niceeval exp experiment",
    "show": "niceeval show",
    "view": "niceeval view"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.47",
    "@types/node": "^26.1.1",
    "dockerode": "^4.0.12",
    "niceeval": "^0.12.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
