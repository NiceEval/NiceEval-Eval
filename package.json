{
  "name": "niceeval-eval",
  "version": "1.0.0",
  "description": "niceeval 的文档效果评估仓库：用 niceeval 评估正在使用 niceeval 的 coding agent",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsx scripts/typecheck.ts",
    "test": "tsx --test scripts/test-*.ts",
    "harness-report": "tsx scripts/harness-report.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.12.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@alibaba-group/opensandbox": "1.1.1",
    "@types/node": "^26.1.1",
    "niceeval": "0.19.1-canary.104",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
